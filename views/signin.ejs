<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in</title>
    <link rel="stylesheet" href="./css/signin.css">
</head>
<body>
   <div class="head"><h1 style="color: black;">ACU</h1><h1 style="color: navy;">BILL</h1></div> 
    <p id="sig">Sign in to your account</p>
<div class="main">
    <form class="mainbox" action="/signin" method="POST">
       
        <div class="ip"><label>Email address</label>
        <input type="email" placeholder="Enter your email" name="email" required>
        </div>
        <div class="ip"><label>Password</label>
        <input type="password" placeholder="Create your 8 password" name="password" required>
        </div>
        <button>Sign in</button>
        <% if(error){ %>
            <p style="color:red"><%= error %></p>
            <% } %>
        <div class="create"><p>Don't have an account?</p>
        <a href="/signup"> Sign up for free</a>
        </div>
    </form>
</div>
</body>
</html>