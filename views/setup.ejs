<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Setup</title>
    <link rel="stylesheet" href="/css/setup.css">
</head>
<body>
    <div class="head">
    <p style="color: black;">ACU</p><p style="color: navy;">BILL</p>
</div>
<p id="sig">Set up your business profile</p>

    <div class="main">
        <form class="mainbox" action="/setup" method="POST">

            <div class="ownername">
                <label>Owner Name</label>
                <input type="text" placeholder="Enter your name" name="ownername" required>
            </div>

            <div class="companyname">
                <label>Name of your Business</label>
                <input type="text" placeholder="Enter name of your Business" name="businessname" required>
            </div>

            <div class="businesstype">
                <label>Type of your Business</label>
                <select name="businesstype" required>
                    <option value="">Select type</option>
                    <option value="Bakery">Bakery</option>
                    <option value="Sweet Shop">Sweet Shop</option>
                    <option value="Grocery">Grocery</option>
                    <option value="Retail">Retail</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="tagline">
                <label>Your Business Tagline</label>
                <input type="text" placeholder="Enter tagline of your Business" name="businesstagline" required>
            </div>

            <div class="address">
                <label>Address of Business</label>
                <input type="text" placeholder="Enter address of your Business" name="address" required>
            </div>

            <div class="row">
                <div>
                    <label>City</label>
                    <input type="text" name="city" placeholder="City" required>
                </div>
                <div>
                    <label>State</label>
                    <input type="text" name="state" placeholder="State" required>
                </div>
                <div>
                    <label>Pincode</label>
                    <input type="text" name="pincode" placeholder="Pincode" required>
                </div>
            </div>

            <div class="phoneno">
                <label>Phone Number</label>
                <input type="tel" placeholder="Enter phone no of your Business" name="phoneno" required>
            </div>

            <div class="gstinno">
                <label>GSTIN No <span class="optional-label">(optional)</span></label>
                <input type="text" placeholder="GSTIN NO" name="gstinno">
            </div>

            <button type="submit">Submit</button>

        </form>
    </div>
</body>
</html>